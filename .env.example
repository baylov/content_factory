# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Mode Configuration
UPBIT_MODE=api                    # Default mode: api or html
UPBIT_NO_AUTOFALLBACK=0            # Disable auto-fallback (0=enabled, 1=disabled)
UPBIT_AGGRESSIVE_MODE=0             # Enable aggressive 50ms polling (0=disabled, 1=enabled)

# Failure Detection Thresholds
UPBIT_API_ERROR_THRESHOLD=5         # API failures before fallback to HTML
UPBIT_API_RECOVERY_OK=20           # Consecutive successes before returning to API

# Timing Configuration (in milliseconds)
UPBIT_API_SLEEP_MS=100,300         # API polling interval range
UPBIT_HTML_REFRESH_MS=800,1200     # HTML refresh interval range  
UPBIT_JITTER_MS=20,40              # Jitter range for both modes

# Aggressive Mode Configuration (when UPBIT_AGGRESSIVE_MODE=1)
# Ultra-aggressive 50ms polling (20 requests/sec) optimized for <1 second latency:
# - 15+ 429s in 60s → 200ms polling (normal mode - 4x slower)
# - 30+ 429s in 60s → 500ms polling (throttled mode - 10x slower)
# - Resume 50ms after 5min of no 429s and no consecutive errors
# - Suggest HTML fallback after 100+ consecutive errors or persistent 429s
# - Expected latency: 300-500ms API + 50-100ms processing = <1 second total